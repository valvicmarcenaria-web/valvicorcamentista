;precos;2;FALSE)*VLOOKUP(\"Aproveitamento\";precos;2;FALSE)))", "chapas", "=D8*VLOOKUP($B8;precos;2;FALSE)", "=IFERROR(F8/$F$20;\"\")", "", "", "", ""], ["MDF Nogueira Thar 15", "=\"Nogueira Thar · Linha Design · Duratex · ⭐ só as QUATRO PORTAS, e é o que se vê do corredor · \"&ROUND(SUMPRODUCT(($K$40:$K$57=$B9)*IF(ISNUMBER($D$40:$D$57);$D$40:$D$57*$E$40:$E$57*$F$40:$F$57;0))/10000;1)&\" m² de peças\"", "=ROUNDUP(SUMPRODUCT(($K$40:$K$57=$B9)*IF(ISNUMBER($D$40:$D$57);$D$40:$D$57*$E$40:$E$57*$F$40:$F$57;0))/10000/(VLOOKUP(\"Área da chapa\";precos;2;FALSE)*VLOOKUP(\"Aproveitamento\";precos;2;FALSE)))", "chapas", "=D9*VLOOKUP($B9;precos;2;FALSE)", "=IFERROR(F9/$F$20;\"\")", "", "", "", ""], ["MDF Off-White Suave 15", "=\"Off-White Suave · Linha Sense · Duratex · o CORPO: laterais, divisória, tampo, base e rodapé · \"&ROUND(SUMPRODUCT(($K$40:$K$57=$B10)*IF(ISNUMBER($D$40:$D$57);$D$40:$D$57*$E$40:$E$57*$F$40:$F$57;0))/10000;1)&\" m² de peças\"", "=ROUNDUP(SUMPRODUCT(($K$40:$K$57=$B10)*IF(ISNUMBER($D$40:$D$57);$D$40:$D$57*$E$40:$E$57*$F$40:$F$57;0))/10000/(VLOOKUP(\"Área da chapa\";precos;2;FALSE)*VLOOKUP(\"Aproveitamento\";precos;2;FALSE)))", "chapas", "=D10*VLOOKUP($B10;precos;2;FALSE)", "=IFERROR(F10/$F$20;\"\")", "", "", "", ""], ["Fita cor", "22 mm na cor da frente · declarada aresta a aresta, mais 10% de desperdício", "=SUMIF($K$40:$K$57;\"Fita cor\";$F$40:$F$57)", "m", "=D11*VLOOKUP(\"Fita cor\";precos;2;FALSE)", "=IFERROR(F11/$F$20;\"\")", "", "", "", ""], ["Fita Branco TX", "22 mm na caixaria · ⭐ R$ 2,00 contra R$ 3,00 da fita de cor · mais 10% de desperdício", "=SUMIF($K$40:$K$57;\"Fita Branco TX\";$F$40:$F$57)", "m", "=D12*VLOOKUP(\"Fita Branco TX\";precos;2;FALSE)", "=IFERROR(F12/$F$20;\"\")", "", "", "", ""], ["Filetagem automática", "Coladeira · peça de 15 e 18 mm · ⭐ serviço por metro de aresta feita, sem desperdício", "=SUMIF($K$40:$K$57;\"Filetagem automática\";$F$40:$F$57)", "m", "=D13*VLOOKUP(\"Filetagem automática\";precos;2;FALSE)", "=IFERROR(F13/$F$20;\"\")", "", "", "", ""], ["Ferragem, terceirizados e iluminação", "Dobradiça, cava usinada, suporte de prateleira e perfil de proteção de piso · linha Hettich · ⛔ sem fonte: as fitas da casa são 110 V", "=SUMPRODUCT((($K$40:$K$57=\"Dobradiça Hettich\")+($K$40:$K$57=\"Suporte de prateleira\"))*IF(ISNUMBER($F$40:$F$57);$F$40:$F$57;0))", "peças", "=SUMIF($K$40:$K$57;\"<>\";$I$40:$I$57)-SUMIF($K$40:$K$57;$B7;$I$40:$I$57)-SUMIF($K$40:$K$57;$B8;$I$40:$I$57)-SUMIF($K$40:$K$57;$B9;$I$40:$I$57)-SUMIF($K$40:$K$57;$B10;$I$40:$I$57)-SUMIF($K$40:$K$57;$B11;$I$40:$I$57)-SUMIF($K$40:$K$57;$B12;$I$40:$I$57)-SUMIF($K$40:$K$57;$B13;$I$40:$I$57)", "=IFERROR(F14/$F$20;\"\")", "", "", "", ""], ["Corte · por chapa", "Serviço de corte, por chapa comprada · R$ 2,00", "=D7+D8+D9+D10", "chapas", "=D15*VLOOKUP(\"Corte por chapa\";precos;2;FALSE)", "=IFERROR(F15/$F$20;\"\")", "", "", "", ""], ["Corte · por peça", "Serviço de corte, por peça cortada · R$ 2,50 · ⛔ conta a PEÇA, não a linha: uma linha de 4 prateleiras são 4 peças", "=SUMPRODUCT((LEFT($K$40:$K$57;4)=\"MDF \")*IF(ISNUMBER($F$40:$F$57);$F$40:$F$57;0))", "peças", "=D16*VLOOKUP(\"Corte por peça\";precos;2;FALSE)", "=IFERROR(F16/$F$20;\"\")", "", "", "", ""], ["Consumíveis", "Cola, lixa, parafuso, cavilha, tapa-furo, fundo e verniz · 6% sobre chapa, fita e filetagem", "", "", "=SUM(F7:F13)*VLOOKUP(\"Consumíveis\";precos;2;FALSE)", "=IFERROR(F17/$F$20;\"\")", "", "", "", ""], ["Embalagem", "Papelão, filme e cantoneira · 2% sobre o subtotal", "", "", "=SUM(F7:F17)*VLOOKUP(\"Embalagem\";precos;2;FALSE)", "=IFERROR(F18/$F$20;\"\")", "", "", "", ""], ["Frete", "⭐ Frete do ambiente · R$ 200 a viagem · ⛔ A QUANTIDADE É SUA: digite quantas viagens este ambiente leva, e o frete aparece aqui e no Painel · sai ZERO e espera", 0, "viagem", "=D19*VLOOKUP(\"Frete\";precos;2;FALSE)", "=IFERROR(F19/$F$20;\"\")", "", "", "", ""], ["CUSTO DIRETO DO AMBIENTE", "", "", "", "=SUM(F7:F19)", "=IFERROR(F20/$F$20;\"\")", "", "", "", ""], ["", "⭐ O FRETE É UMA LINHA DO AMBIENTE, R$ 200 a viagem: a QUANTIDADE é a célula AMARELA no fim do painel de material, e ela sai ZERO.   ⭐⭐ TRÊS PADRÕES NUM ARMÁRIO SÓ, e é de propósito: do corredor se vê uma parede de Nogueira Thar, e por dentro tudo é claro. ⛔ Mas três padrões são três compras e três arredondamentos de chapa, e cada um puxa no mínimo uma chapa inteira mesmo que sobre — num armário de 230 isso pesa.   ⭐ AS QUATRO FOLHAS TÊM 2,56 M e levam TRÊS dobradiças cada, não duas: folha desse porte descai na segunda.   ⭐ O puxador é cava QUADRADA de 10 × 10,5, não cava corrida: são 10 cm de usinagem por folha, não 57,5.", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["  OS ITENS   ·   cada móvel com o seu custo, porque é assim que a fábrica produz e o cliente confere", "", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["ITEM", "MÓVEL", "MEDIDA GERAL", "", "", "", "", "CUSTO", "", ""], [1, "ELEVAÇÃO A Armário da rouparia", "230 × 275 × 50", "", "", "", "", "=I57", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["Soma dos itens · chapa rateada em fração", "", "", "", "", "", "", "=SUM(I26:I26)", "", ""], ["Arredondamento de chapa para número cheio · ⛔ a regra de ferro", "", "", "", "", "", "", "=F7+F8+F9+F10-SUMIF($K$40:$K$57;$B7;$I$40:$I$57)-SUMIF($K$40:$K$57;$B8;$I$40:$I$57)-SUMIF($K$40:$K$57;$B9;$I$40:$I$57)-SUMIF($K$40:$K$57;$B10;$I$40:$I$57)", "", ""], ["MATERIAL E FERRAGEM, PELO RATEIO DOS ITENS", "", "", "", "", "", "", "=I28+I29", "", ""], ["Material e ferragem, pelo painel do ambiente", "", "", "", "", "", "", "=SUM(F7:F14)", "", ""], ["⭐ CONFERÊNCIA — as duas contas têm de dar a mesma coisa", "", "", "", "", "", "", "=I30-I31", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["  O QUE NÃO É MARCENARIA   ·   está na prancha, não está nesta conta", "", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["⭐ NADA — e é o único ambiente da casa assim. A elevação não traz pedra, vidro, serralheria, elétrica nem alvenaria: do rodapé ao topo, os 230 × 275 são marcenaria, e o que o corredor vê é só a nossa Nogueira Thar.", "", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["  AS PEÇAS, ITEM POR ITEM   ·   cada linha é uma peça que vai para o plano de corte", "", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""]], "notas_range": "B59:K62", "notas": [["  NOTAS E PONTOS EM ABERTO   ·   o que ainda precisa de decisão antes de virar preço", "", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["", "⭐ O ARMÁRIO É SÓ PRATELEIRA: dez delas, em duas colunas de cinco, mais o maleiro de 66 no topo. Não há gaveta, não há cabideiro e não há ferragem de movimento além das doze dobradiças.", "", "", "", "", "", "", "", ""], ["", "⭐ É O AMBIENTE MAIS BARATO POR METRO LINEAR DA CASA, e é o que mais aparece: fica no corredor, de frente para quem passa. A Nogueira Thar das portas é o que o cliente vê.", "", "", "", "", "", "", "", ""]], "duvidas_range": "B64:K68", "duvidas": [["  ⚠ DÚVIDAS DE ORÇAMENTO   ·   numeradas, para o senhor responder em cima · nenhuma delas trava o preço", "", "", "", "", "", "", "", "", ""], ["", "", "", "", "", "", "", "", "", ""], ["01", "⚠ A PROFUNDIDADE DE 50 NÃO ESTÁ COTADA em nenhuma das duas pranchas. Adotei 50, que é o padrão de rouparia da casa. ⛔ Se for 60, as dez prateleiras e as duas laterais crescem 20% em área, e isso é quase uma chapa a mais. Conferir na medição técnica.", "", "", "", "", "", "", "", ""], ["02", "⭐ A ELEVAÇÃO COTA 275 DE ALTURA e a chapa dá 273. Rebaixei lateral, divisória e fundo para 273 e deixei a diferença no rodapé, que é a peça que esconde folga. ⚠ Se o pé-direito do corredor for exatamente 275, o armário entra justo e não há onde errar: medir antes de cortar.", "", "", "", "", "", "", "", ""], ["03", "AS DEZ PRATELEIRAS SÃO DE 113 DE VÃO. ⭐ Passam dos 70 que pedem 18 mm e ficam abaixo dos 120 que pedem alma de aço — é o único armário grande da casa que não leva barra. ⚠ Mas rouparia carrega toalha e roupa de cama empilhada, que é peso concentrado. Se a fábrica achar pouco, a alma custa R$ 50 por prateleira.", "", "", "", "", "", "", "", ""]], "requests": [{"unmergeCells": {"range": {"sheetId": 106, "startRowIndex": 0, "endRowIndex": 68, "startColumnIndex": 0, "endColumnIndex": 11}}}, {"repeatCell": {"range": {"sheetId": 106, "startRowIndex": 0, "endRowIndex": 68, "startColumnIndex": 0, "endColumnIndex": 11}, "cell": {"userEnteredFormat": {"textFormat": {"fontFamily": "Arial", "fontSize": 10, "foregroundColor": {"red": 0.102, "green": 0.102, "blue": 0.102}}, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE", "wrapStrategy": "CLIP"}}, "fields": "userEnteredFormat"}}, {"repeatCell": {"range": {"sheetId": 106, "startRowIndex": 0, "endRowIndex": 68, "startColumnIndex": 9, "endColumnIndex": 10}, "cell": {"userEnteredFormat": {"textFormat": {"fontFamily": "Arial", "fontSize": 9, "foregroundColor": {"red": 0.675, "green": 0.675, "blue": 0.675}}, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE", "wrapStrategy": "CLIP"}}, "fields": "userEnteredFormat"}}, {"repeatCell": {"range": {"sheetId": 106, "startRowIndex": 0, "endRowIndex": 68, "startColumnIndex": 10, "endColumnIndex": 11}, "cell": {"userEnteredFormat": {"textFormat": {"fontFamily": "Arial", "fontSize": 8, "foregroundColor": {"red": 0.675, "green": 0.675, "blue": 0.675}}, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE", "wrapStrategy": "CLIP"}}, "fields": "userEnteredFormat"}}, {"repeatCell": {"range": {"sheetId": 106, "startRowIndex": 0, "endRowIndex": 1, "startColumnIndex": 1, "endColumnIndex": 9}, "cell": {"userEnteredFormat": {"textFormat": {"fontFamily": "Arial", "fontSize": 16, "foregroundColor": {"red": 1, "green": 1, "blue": 1}, "bold": true}, "horizontalAlignment": "LEFT", "verticalAlignment": "MIDDLE", "wrapStrategy": "CLIP", "backgroundColor": {"red": 0.102, "green": 0.102, "blue": 0.102}}}, "fiel